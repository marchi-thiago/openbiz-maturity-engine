# Configure pelo menos a chave do provedor escolhido.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos usados pelo adaptador de cada provedor.
AI_GEMINI_MODEL=gemini-3.5-flash
AI_CLAUDE_MODEL=claude-sonnet-4-20250514

# Gemini e o provedor primario neste projeto.
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=claude
AI_FALLBACK_ENABLED=false
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5
AI_MAX_OUTPUT_TOKENS=4096
